# rustyAC server kit: copy to .env next to docker-compose.yml and change the values.
# Every value here is made up. Never commit the real .env.

# --- the fixed servers (Spa, Laguna Seca) ---
AC_PACK_DIR=/srv/rustyac/dist-server
AC_ADMIN_PASSWORD=change-me-admin
AC_PASSWORD=
SPA_GAME_PORT=9600
SPA_HTTP_PORT=8091
SPA_GATEWAY_PORT=9601
LAGUNA_GAME_PORT=9610
LAGUNA_HTTP_PORT=8092
LAGUNA_GATEWAY_PORT=9611
# the gateways' and the panel's host address (the tunnel reaches it; docker0 on tsss-server)
GATEWAY_BIND=10.0.1.1
GATEWAY_ORIGINS=https://rustyac.example.com
GATEWAY_MAX_CLIENTS=12

# --- the server panel (docker compose --profile panel up -d) ---
PANEL_PORT=9680
PANEL_ROUTER_PORT=9681
# presets and the running servers' config folders (owned by uid 1000, the panel's user)
PANEL_DATA_DIR=/srv/rustyac/panel
# the page the browser join links open, and the address desktops join (LAN / tailnet name)
PANEL_SITE_URL=https://rustyac.example.com/
PANEL_GAME_HOST=my-server.example-tailnet.ts.net
PANEL_MAX_SERVERS=3
# port pools of the on-demand servers: game (TCP+UDP), acServer HTTP, gateway
PANEL_GAME_PORTS=9620-9629
PANEL_HTTP_PORTS=9630-9639
PANEL_GATEWAY_PORTS=9640-9649
# Cloudflare Access: Zero Trust > Settings > Custom pages shows the team domain; the
# application's Overview tab shows its Application Audience (AUD) Tag
CF_ACCESS_TEAM_DOMAIN=example-team.cloudflareaccess.com
CF_ACCESS_AUD=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
